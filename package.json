{
  "name": "@robustive/robustive-ts",
  "version": "1.2.0",
  "description": "Reactive and OBjective USecase Transactor for TypeScript.",
  "main": "./dist/robustive.umd.js",
  "module": "./dist/robustive.es.js",
  "types": "./types/index.d.ts",
  "files": [
    "/dist",
    "/types"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/robustive.es.js"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./dist/robustive.umd.js"
      }
    }
  },
  "scripts": {
    "build:clean": "shx rm -rf ./dist ./types",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "prepack": "yarn build",
    "prepare": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Robustive/Robustive-ts"
  },
  "author": "Yusuke SAITO <yusuke.saito@jibunstyle.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^17.12.0",
    "shx": "^0.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.12.0"
}
